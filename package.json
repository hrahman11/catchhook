        "format": "prettier --write resources/js tests/js",
        "format:check": "prettier --check resources/js tests/js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.3",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
